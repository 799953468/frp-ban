{
  "ClientSettings": {
    "ServerAddress": "localhost",
    "ServerPort": 9443,
    "Token": "CHANGE_ME_TO_MATCH_SERVER_TOKEN",
    "Tls": {
      "Enabled": true,
      "ClientCertificatePath": "certs/client.pfx",
      "ClientCertificatePassword": "",
      "CaCertificatePath": "certs/ca.crt",
      "AllowSelfSignedCertificates": false,
      "ValidateServerCertificate": true
    },
    "Reconnection": {
      "MaxRetries": -1,
      "InitialDelayMs": 1000,
      "MaxDelayMs": 30000,
      "BackoffMultiplier": 2.0,
      "HealthCheckIntervalMs": 30000
    },
    "InputMethod": "stdin",
    "AppLogPath": null
  }
}
