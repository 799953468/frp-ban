[Unit]
Description=FRP Ban Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frp-ban
Group=frp-ban
WorkingDirectory=/etc/frp-ban
ExecStart=/opt/frp-ban/FrpBan
EnvironmentFile=-/etc/frp-ban/env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/frp-ban /var/log/frp-ban

[Install]
WantedBy=multi-user.target
